#!/usr/bin/env ruby
# frozen_string_literal: true

# Fills the gitignored .env with the deploy secrets from 1Password, in one `op` call, so deploys
# never prompt. Run once per machine and after rotating a secret. Values are never printed.
#
#   bin/secrets-pull                      # writes ./.env (mode 600)
#
# Environment overrides: HOME_HQ_OP_ITEM (default "Home HQ"), HOME_HQ_OP_VAULT
# ("keys"), HOME_HQ_OP_ACCOUNT (op's default account), HOME_HQ_ENV_FILE (./.env).

require "json"
require "open3"
require "fileutils"

FIELDS = {
  "master_key" => "RAILS_MASTER_KEY",
  "r2_access_key_id" => "LITESTREAM_ACCESS_KEY_ID",
  "r2_secret_access_key" => "LITESTREAM_SECRET_ACCESS_KEY",
  "r2_bucket" => "LITESTREAM_BUCKET",
  "r2_endpoint" => "LITESTREAM_ENDPOINT",
  "telegram_bot_token" => "TELEGRAM_BOT_TOKEN",
  "telegram_chat_id" => "TELEGRAM_CHAT_ID",
  "cloudflare_tunnel_token" => "CLOUDFLARE_TUNNEL_TOKEN",
  "home_assistant_url" => "HOME_ASSISTANT_URL",
  "home_assistant_token" => "HOME_ASSISTANT_TOKEN",
  "home_assistant_webhook_secret" => "HOME_ASSISTANT_WEBHOOK_SECRET",
  "immich_url" => "IMMICH_URL",
  "immich_api_key" => "IMMICH_API_KEY"
}.freeze
OPTIONAL = %w[TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID CLOUDFLARE_TUNNEL_TOKEN HOME_ASSISTANT_URL HOME_ASSISTANT_TOKEN
  HOME_ASSISTANT_WEBHOOK_SECRET IMMICH_URL IMMICH_API_KEY].freeze

item = ENV.fetch("HOME_HQ_OP_ITEM", "Home HQ")
vault = ENV.fetch("HOME_HQ_OP_VAULT", "keys")
env_file = ENV.fetch("HOME_HQ_ENV_FILE", File.expand_path("../.env", __dir__))

command = [ "op", "item", "get", item, "--vault", vault, "--format", "json" ]
command += [ "--account", ENV["HOME_HQ_OP_ACCOUNT"] ] if ENV["HOME_HQ_OP_ACCOUNT"]

out, err, status = Open3.capture3(*command)
abort("secrets-pull: op failed: #{err.strip}") unless status.success?

values = JSON.parse(out).fetch("fields").each_with_object({}) do |field, hash|
  name = FIELDS[field["label"]]
  hash[name] = field["value"].to_s if name
end

missing = FIELDS.values - values.keys - OPTIONAL
abort("secrets-pull: item \"#{item}\" is missing #{missing.join(", ")}") if missing.any?

lines = FIELDS.values.map { |name| "#{name}=#{values.fetch(name, "")}" }
File.open(env_file, File::WRONLY | File::CREAT | File::TRUNC, 0o600) { |f| f.puts(lines) }
File.chmod(0o600, env_file)

puts "secrets-pull: wrote #{lines.size} variables to #{env_file} (#{(FIELDS.values & values.keys).size} set" \
     "#{", #{(OPTIONAL - values.keys).join(", ")} empty" if (OPTIONAL - values.keys).any?})"
