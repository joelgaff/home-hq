# Secrets referenced by config/deploy.yml (env/secret, accessories/*/env/secret). This file is
# committed and holds only references, Kamal's own convention: the values come from the
# environment, which bin/kamal fills from a gitignored .env in the project root.
# DO NOT ENTER RAW CREDENTIALS HERE.
#
# Fill .env once per machine with `bin/secrets-pull` (one 1Password call; see the README), and
# again after rotating anything. 1Password stays the source of truth; .env is a local copy.

RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# A placeholder: the image registry on the laptop's loopback has no authentication, but Kamal
# wants credentials whenever the server is addressed as 127.0.0.1 (deploying to this machine).
KAMAL_REGISTRY_PASSWORD=local

LITESTREAM_ACCESS_KEY_ID=$LITESTREAM_ACCESS_KEY_ID
LITESTREAM_SECRET_ACCESS_KEY=$LITESTREAM_SECRET_ACCESS_KEY
LITESTREAM_BUCKET=$LITESTREAM_BUCKET
LITESTREAM_ENDPOINT=$LITESTREAM_ENDPOINT

# Only at home, behind a Cloudflare Tunnel (the accessory exists only when this is set).
TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN

# Empty until the Telegram bot exists (alerts are then a logged no-op).
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=$TELEGRAM_CHAT_ID

# Home Assistant and Immich beside the app: empty until each is set up (blank = off).
HOME_ASSISTANT_URL=$HOME_ASSISTANT_URL
HOME_ASSISTANT_TOKEN=$HOME_ASSISTANT_TOKEN
HOME_ASSISTANT_WEBHOOK_SECRET=$HOME_ASSISTANT_WEBHOOK_SECRET
IMMICH_URL=$IMMICH_URL
IMMICH_API_KEY=$IMMICH_API_KEY
