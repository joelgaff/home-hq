<%# The Chores view (ui-spec §1.3): one routine at a time, a lane per person plus Anyone. With no
    routines yet (right after a fresh start) the frame says where they come from. %>
<% if routine.nil? %>
  <%= turbo_frame_tag "chores" do %>
    <div class="tasks"><div class="ch-empty"><h1 class="serif">No routines yet</h1><p>Add routines and chores in Settings and they show up here.</p></div></div>
  <% end %>
<% else %>
<% current = @household.current_routine %>
<% done, total = @household.routine_progress(routine) %>
<%= turbo_frame_tag "chores", data: { routine: routine.id } do %>
  <div class="tasks" data-controller="picker" data-action="click->picker#pick">
    <header class="t-head">
      <div class="t-title"><div class="label"><%= "Right now · " if routine == current %><%= routine.range_label %></div><h1 class="serif"><%= routine.name %></h1></div>
      <div class="seg">
        <% @household.active_routines.each do |r| %>
          <%= link_to r.name, chores_path(routine: (r == current ? nil : r.id)), class: (r == routine ? "is-on" : ""), data: { routine: r.id } %>
        <% end %>
      </div>
      <div class="t-progress"><span class="num"><%= done %><small>/<%= total %></small></span><div class="t-bar"><i style="width:<%= total.positive? ? format('%.2f', done * 100.0 / total) : 0 %>%"></i></div><span class="label">done</span></div>
    </header>
    <% unless frame_layout? %>
      <%# Phone (the approved mockup): chips narrow the stacked lanes to one person; kids first. %>
      <div class="ch-chips">
        <% (@household.people.kids + @household.people.reject(&:kid?)).each do |p| %>
          <button class="chip" style="<%= p.style %>" data-pick="<%= p.id %>"><%= avatar(p, 32) %><b><%= p.name %></b><% if p.kid? %><span class="ch-chip-stars"><%= icon("star", 14, "i--fill") %><span class="num"><%= p.stars %></span></span><% end %></button>
        <% end %>
        <button class="chip" style="<%= @household.family.style %>" data-pick="any"><%= avatar(@household.family, 32) %><b>Anyone</b></button>
      </div>
    <% end %>
    <% if @household.chores_paused? %>
      <div class="ch-paused label">Chores paused until <%= fmt_month(@household.chores_paused_until) %> <%= @household.chores_paused_until.day %></div>
    <% end %>
    <% lane_count = @household.people.size + 1 %>
    <div class="ch-lanes<%= " is-many" if lane_count > 6 %>" style="--lanes:<%= lane_count %>" data-picker-target="lanes">
      <% (@household.people.to_a + [ nil ]).each do |person| %>
        <%= render "chores/lane", routine: routine, person: person %>
      <% end %>
    </div>
  </div>
<% end %>
<% end %>
