<%# The "Overlapping" sheet behind a "+N more" block. %>
<%= turbo_frame_tag "sheet" do %>
  <div class="sheet-body sheet-pad" data-sheet-class="">
    <div class="label">Overlapping</div>
    <h2 class="serif sheet-h"><%= @events.size %> more events</h2>
    <div class="more-list">
      <% @events.each do |e| %>
        <button class="more-row" data-ev="<%= e.id %>" style="<%= e.color_person.style %>"><i></i><b><%= e.title %></b><span><%= fmt_range(e.starts_at, e.ends_at) %></span></button>
      <% end %>
    </div>
  </div>
<% end %>
