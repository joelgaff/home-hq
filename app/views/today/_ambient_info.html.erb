<% household = Current.household %>
<% now = Current.now %>
<% report = household.latest_weather %>
<% next_event = household.next_event(at: now) %>
<%= turbo_frame_tag "ambient-info", class: "amb-right", data: { controller: "refresh", refresh_every_value: "hour", refresh_at_value: ms(next_event ? next_event.starts_at : now.tomorrow.beginning_of_day), refresh_url_value: today_path(part: "ambient_info") } do %>
  <% if report %>
    <% w = report.outlook(at: now) %>
    <div class="amb-wx"><%= icon(w.condition, 44) %><span class="num"><%= w.temperature %>°</span><small><%= w.summary %></small></div>
  <% end %>
  <% if next_event %>
    <div class="amb-next" style="<%= next_event.color_person.style %>"><i></i><%= next_event.title %> · <%= fmt_time(next_event.starts_at) %></div>
  <% end %>
  <div class="amb-who"><% household.people.each do |p| %><%= avatar(p, 34, p.home? ? nil : "avatar--away") %><% end %></div>
<% end %>
