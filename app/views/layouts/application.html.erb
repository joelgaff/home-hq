<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Home HQ" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F2EEE6">
    <meta name="application-name" content="Home HQ">
    <meta name="apple-mobile-web-app-title" content="Home HQ">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Instrument+Serif:ital@0;1&display=swap">
    <%# The plain pages (sign in, screens) share the dashboard's tokens and type. %>
    <%= stylesheet_link_tag "dashboard/tokens", "dashboard/pages", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="page-body">
    <main class="page">
      <div class="page-brand label">Home HQ</div>
      <% if notice %><p class="page-flash"><%= notice %></p><% end %>
      <% if alert %><p class="page-flash page-flash--alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
